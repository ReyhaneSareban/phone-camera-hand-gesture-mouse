
import cv2
import mediapipe as mp
import pyautogui

click_frames = 0
click_active = False

drag_frames = 0
release_frames = 0

smooth_x, smooth_y = 0, 0
smooth_factor = 0.15
previous_y = None
scroll_threshold = 0.015
clicked = False
drag = False

mp_hands = mp.solutions.hands

hands = mp_hands.Hands(
    max_num_hands=1,
    min_detection_confidence=0.6,
    min_tracking_confidence=0.6
)

mp_draw = mp.solutions.drawing_utils
hand_style = mp_draw.DrawingSpec(
    color=(200, 200, 200),
    thickness=1,
    circle_radius=2
)

connection_style = mp_draw.DrawingSpec(
    color=(245, 245, 245),
    thickness=1
)

cam = cv2.VideoCapture(3)

screen_w, screen_h = pyautogui.size()

while True:
    _, frame = cam.read()
    frame = cv2.flip(frame, 1)
    h, w, _ = frame.shape

    frameRGB = cv2.cvtColor(frame, cv2.COLOR_BGR2RGB)
    results = hands.process(frameRGB)

    if results.multi_hand_landmarks:
        for landmark in results.multi_hand_landmarks:
            mp_draw.draw_landmarks(
                frame,
                landmark,
                mp_hands.HAND_CONNECTIONS,
                hand_style,
                connection_style
            )

            lm = landmark.landmark

            index_open = lm[8].y < lm[6].y
            middle_open = lm[12].y < lm[10].y
            ring_open = lm[16].y < lm[14].y
            pinky_open = lm[20].y < lm[18].y

            palm_width = abs(lm[5].x - lm[17].x)
            thumb_open = abs(lm[4].x - lm[5].x) > palm_width * 0.8
            
            index_finger_tip = lm[8]
            x = int(index_finger_tip.x * w)
            y = int(index_finger_tip.y * h)

            cv2.circle(frame, (x, y), 10, (45, 30, 139), 2)
            cv2.circle(frame, (x, y), 4, (45, 30, 139), -1)

            screen_x = int((x / w - 0.5) * screen_w * 2 + screen_w / 2)
            screen_y = int((y / h - 0.5) * screen_h * 2 + screen_h / 2)

            screen_x = max(0, min(screen_x, screen_w - 1))
            screen_y = max(0, min(screen_y, screen_h - 1))

            if smooth_x == 0 and smooth_y == 0:
                smooth_x, smooth_y = screen_x, screen_y

            smooth_x = smooth_x + (screen_x - smooth_x) * smooth_factor
            smooth_y = smooth_y + (screen_y - smooth_y) * smooth_factor

            pyautogui.moveTo(int(smooth_x), int(smooth_y))

            click_gesture = (
                index_open
                and middle_open
                and not ring_open
                and not pinky_open
                and not thumb_open
            )

            if click_gesture:
                click_frames += 1

                if click_frames >= 3 and not click_active:
                    pyautogui.click()
                    print("Click")
                    click_active = True
            else:
                click_frames = 0
                click_active = False

            drag_gesture = (
                index_open
                and pinky_open
                and not middle_open
                and not ring_open
                and not thumb_open
            )

            if drag_gesture:
                release_frames = 0

                if not drag:
                    drag_frames += 1

                    if drag_frames >= 3:
                        pyautogui.mouseDown()
                        drag = True
                        print("Dragging...")
            else:
                drag_frames = 0

                if drag:
                    release_frames += 1

                    if release_frames >= 3:
                        pyautogui.mouseUp()
                        drag = False
                        release_frames = 0
                        print("Dropped")

            if thumb_open and not index_open and not middle_open and not pinky_open:
                wrist_y = landmark.landmark[0].y

                if previous_y is not None:
                    movement = wrist_y - previous_y

                    if abs(movement) > scroll_threshold:
                        pyautogui.scroll(int(-movement * 1000))

                previous_y = wrist_y
            else:
                previous_y = None

    else:
        if drag:
            pyautogui.mouseUp()
            drag = False

        drag_frames = 0
        release_frames = 0
        click_frames = 0
        click_active = False

    cv2.imshow("Camera", frame)

    if cv2.waitKey(1) == ord('q'):
        break

cam.release()
hands.close()
cv2.destroyAllWindows()
